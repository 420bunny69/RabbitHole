# Copy this file to .env and fill in real values. Never commit .env.

# Database: SQLite for local development, Postgres (e.g. Neon) for deployment.
# Postgres example: postgresql+psycopg://user:password@host/dbname
DATABASE_URL=sqlite:///./rabbithole.db

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# AI provider: "groq" (hosted, free tier) or "ollama" (local, no key needed).
# Groq key: sign in at https://console.groq.com, open "API Keys" and create one.
# Ollama: install from https://ollama.com, run `ollama pull llama3.1`, set LLM_PROVIDER=ollama.
# Restart uvicorn after changing this file.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
