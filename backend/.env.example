# Copy this file to .env and fill in real values. Never commit .env.

# Database: SQLite for local development, Postgres (e.g. Neon) for deployment.
# Postgres example: postgresql+psycopg://user:password@host/dbname
DATABASE_URL=sqlite:///./rabbithole.db

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# AI provider: "groq" (hosted) or "ollama" (local)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
